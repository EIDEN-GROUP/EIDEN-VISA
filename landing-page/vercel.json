{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/contact/", "destination": "/contact", "statusCode": 301 },
    { "source": "/blog/", "destination": "/blog", "statusCode": 301 },
    { "source": "/conditions/", "destination": "/conditions", "statusCode": 301 },
    { "source": "/confidentialite/", "destination": "/confidentialite", "statusCode": 301 },
    { "source": "/cookies/", "destination": "/cookies", "statusCode": 301 },
    { "source": "/securite/", "destination": "/securite", "statusCode": 301 },
    { "source": "/conditions.html", "destination": "/conditions", "statusCode": 301 },
    { "source": "/confidentialite.html", "destination": "/confidentialite", "statusCode": 301 },
    { "source": "/cookies.html", "destination": "/cookies", "statusCode": 301 },
    { "source": "/securite.html", "destination": "/securite", "statusCode": 301 },
    {
      "source": "/rendez-vous-tlscontact-bls-agadir-2026/",
      "destination": "/blog/rendez-vous-tlscontact-bls-agadir-2026/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/conditions", "destination": "/conditions/index.html" },
    { "source": "/confidentialite", "destination": "/confidentialite/index.html" },
    { "source": "/cookies", "destination": "/cookies/index.html" },
    { "source": "/securite", "destination": "/securite/index.html" }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/favicon.ico",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
